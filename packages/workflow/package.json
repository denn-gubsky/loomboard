{
  "name": "@loomboard/workflow",
  "version": "0.1.0",
  "type": "module",
  "description": "Reusable React canvas for loomcycle TeamDef workflows — author the agent-team graph, run it, monitor it, and interact with its agents.",
  "license": "Apache-2.0",
  "author": "Dennis Gubsky",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denn-gubsky/loomboard.git",
    "directory": "packages/workflow"
  },
  "keywords": [
    "loomcycle",
    "loomboard",
    "teamdef",
    "workflow",
    "canvas",
    "react",
    "agent",
    "component"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "testdata"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.config.lib.ts && tsc -p tsconfig.lib.json && cp src/styles.css dist/styles.css",
    "prepack": "npm run build:lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@loomcycle/def-fields": "^0.2.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@xyflow/react": "^12.11.6",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@loomcycle/def-fields": "^0.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
