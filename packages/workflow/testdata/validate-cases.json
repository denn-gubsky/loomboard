    {
      "name": "unknown handler kind from a newer runtime",
      "go_valid": false,
      "ts_valid": true,
      "why_divergent": "RFC CZ decision 3. The runtime rejects a kind it does not implement, and must. The canvas must NOT: it may be an older build talking to a newer runtime, and refusing to render a `starter` would push the operator back to hand-editing JSON. The canvas renders it opaque, preserves it byte-for-byte, reports it at info, and lets the server be the authority.",
      "definition": {
        "entry": "on-pr",
        "states": [
          {
            "state": "on-pr",
            "handler": {
              "kind": "starter",
              "source": {
                "channel": "pr-events",
                "wait": "any"
              },
              "fanout": {
                "agent": "reviewer",
                "per": "message",
                "max": 8
              },
              "sink": {
                "channel": "verdicts"
              }
            }
          },
          {
            "state": "done",
            "handler": {
              "kind": "terminal"
            }
          }
        ],
        "transitions": [
          {
            "from": "on-pr",
            "to": "done",
            "on": "success"
          }
        ]
      }
